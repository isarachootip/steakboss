# Database (Local SQLite default; switch Prisma provider to postgresql for production)
DATABASE_URL="file:./dev.db"

# Auth Session Secret (change to strong random 32+ chars in production)
SESSION_SECRET="steakboss-dev-session-secret-change-in-prod-32chars"
CRON_SECRET="steakboss-cron-secret-change-in-prod"

# Public App URL (used for LINE Login callback, LINE Flex links & OpenGraph metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LINE Official Account Messaging API (push notifications & webhook)
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_STAFF_GROUP_ID=""

# LINE Login Channel (Web OAuth 2.0 — callback: <NEXT_PUBLIC_APP_URL>/api/auth/line/callback)
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# Slip Verification API (slipok | easyslip | thunder; leave key blank for Admin Manual Review)
SLIP_VERIFY_PROVIDER="manual"
SLIP_VERIFY_API_URL=""
SLIP_VERIFY_API_KEY=""

# Gemini AI for BossBot (leave blank for deterministic Rule Engine Mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
