# Database (Local SQLite default; switch Prisma provider to postgresql for production)
DATABASE_URL="file:./dev.db"

# Auth Session Secret (change to strong random 32+ chars in production)
SESSION_SECRET="steakboss-dev-session-secret-change-in-prod-32chars"
CRON_SECRET="steakboss-cron-secret-change-in-prod"

# Public App URL (used for LINE Flex links & OpenGraph metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LINE Official Account Messaging API (leave blank to run in Sandbox Mode)
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_STAFF_GROUP_ID=""

# Slip Verification API (SlipOK / EasySlip; leave blank for Sandbox + Manual Review Mode)
SLIP_VERIFY_PROVIDER="sandbox"
SLIP_VERIFY_API_URL=""
SLIP_VERIFY_API_KEY=""

# Gemini AI for BossBot (leave blank for deterministic Rule Engine Mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
