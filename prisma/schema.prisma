generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  role         String       @default("CUSTOMER") // CUSTOMER | WHOLESALE | OWNER | ADMIN | PACKER
  isActive     Boolean      @default(true)
  name         String
  phone        String?      @unique
  email          String?      @unique
  lineUserId     String?      @unique
  linePictureUrl String?
  passwordHash   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  addresses    Address[]
  orders       Order[]
  chatThreads  ChatThread[]
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  label         String  @default("บ้าน")
  recipientName String
  phone         String
  addressLine   String
  postalCode    String
  isDefault     Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  sku                String          @unique
  name               String
  subtitle           String
  description        String
  categoryId         String
  weightGrams        Int
  priceBaht          Float
  wholesalePriceBaht Float           @default(0)
  bulkPriceBaht      Float?
  bulkMinQty         Int             @default(0)
  packSize           Int             @default(1)
  costBaht           Float           @default(0)
  stockQty           Int             @default(0)
  lowStockThreshold  Int             @default(10)
  isBundle           Boolean         @default(false)
  isNew              Boolean         @default(false)
  isActive           Boolean         @default(true)
  tag                String          @default("")
  platedImgUrl       String
  packImgUrl         String
  wideImgUrl         String?
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  category           Category        @relation(fields: [categoryId], references: [id])
  bundleComponents   BundleItem[]    @relation("BundleParent")
  includedInBundles  BundleItem[]    @relation("BundleChild")
  stockMovements     StockMovement[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
}

model BundleItem {
  id              String  @id @default(cuid())
  parentProductId String
  childProductId  String
  quantity        Int     @default(1)
  parent          Product @relation("BundleParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  child           Product @relation("BundleChild", fields: [childProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, childProductId])
}

model StockMovement {
  id              String   @id @default(cuid())
  productId       String
  deltaQty        Int
  type            String   // RESTOCK | RESERVE | DEDUCT | RELEASE | ADJUST
  reason          String   @default("")
  orderNo         String?
  purchaseOrderNo String?
  goodsReceiptNo  String?
  actorId         String?
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNo          String              @unique
  supplierName  String              @default("โรงงานอ่างทอง")
  status        String              @default("OPEN") // OPEN | PARTIAL | RECEIVED | SHORT_CLOSED | CANCELLED
  expectedDate  DateTime
  note          String              @default("")
  totalCostBaht Float               @default(0)
  createdById   String
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         PurchaseOrderItem[]
  receipts      GoodsReceipt[]

  @@index([status, expectedDate])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id                  String             @id @default(cuid())
  purchaseOrderId     String
  productId           String
  skuSnapshot         String
  productNameSnapshot String
  orderedQty          Int
  receivedQty         Int                @default(0)
  unitCostBaht        Float              @default(0)
  lineTotalBaht       Float              @default(0)
  purchaseOrder       PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id])
  receiptItems        GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  receiptNo       String             @unique
  purchaseOrderId String
  deliveryNoteNo  String             @default("")
  note            String             @default("")
  status          String             @default("POSTED") // POSTED | VOIDED
  receivedById    String
  voidedById      String?
  voidReason      String?
  voidedAt        DateTime?
  receivedAt      DateTime           @default(now())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  skuSnapshot         String
  receivedQty         Int
  unitCostBaht        Float             @default(0)
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // FIXED | PERCENT | FREE_SHIP
  value       Float
  minSubtotal Float     @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model StoreSetting {
  id                String   @id @default("default")
  bkkShipBaht       Int      @default(60)
  upcShipBaht       Int      @default(120)
  freeShipThreshold Int      @default(990)
  codFeeBaht        Int      @default(20)
  wholesaleMinPacks Int      @default(10)
  phone             String   @default("081-234-5678")
  lineId            String   @default("@steakboss")
  lineOaUrl         String   @default("https://line.me/R/ti/p/@steakboss")
  promptpayId       String   @default("0932896292")
  promptpayName     String   @default("วรัป เจริญโพธิ์")
  facebookPage      String   @default("steakbossoriginal")
  unpaidExpireHours Int      @default(24)
  updatedAt         DateTime @updatedAt
}

model Order {
  id             String       @id @default(cuid())
  orderNo        String       @unique
  userId         String?
  channel        String       @default("WEB") // WEB | LINE
  status         String       @default("PENDING_PAYMENT")
  pricingTier    String       @default("RETAIL") // RETAIL | WHOLESALE | BULK
  customerName   String
  customerPhone  String
  customerEmail  String       @default("")
  deliveryMethod String       @default("COLD_CHAIN") // COLD_CHAIN | FACTORY_PICKUP
  shippingZone   String       @default("BKK") // BKK | UPC | PICKUP
  postalCode     String       @default("")
  addressText    String       @default("")
  note           String       @default("")
  subtotalBaht   Float
  discountBaht   Float        @default(0)
  shippingBaht   Float        @default(0)
  codFeeBaht     Float        @default(0)
  totalBaht      Float
  couponCode     String?
  paymentMethod  String       @default("PROMPTPAY") // PROMPTPAY | COD
  carrier        String       @default("")
  trackingNo     String       @default("")
  codSettled     Boolean      @default(false)
  stockDeducted  Boolean      @default(false)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User?        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]

  @@index([status, createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  productName   String
  appliedTier   String  @default("RETAIL") // RETAIL | WHOLESALE | BULK
  unitPriceBaht Float
  unitCostBaht  Float   @default(0)
  quantity      Int
  lineTotalBaht Float
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String   @default("")
  actorId   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String    @id @default(cuid())
  orderId      String
  method       String
  status       String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  amountBaht   Float
  slipUrl      String?
  slipTransRef String?   @unique
  slipHash     String?   @unique
  provider     String    @default("sandbox")
  verifiedById String?
  rejectReason String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ChatThread {
  id              String        @id @default(cuid())
  channel         String        // WEB | LINE
  externalId      String
  customerName    String        @default("ลูกค้าหน้าร้าน")
  userId          String?
  mode            String        @default("BOT") // BOT | HUMAN
  assignedAdminId String?
  lastMessageAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  user            User?         @relation(fields: [userId], references: [id])
  messages        ChatMessage[]

  @@unique([channel, externalId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  sender    String     // CUSTOMER | BOT | ADMIN
  content   String
  mediaUrl  String?
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model LandingContent {
  id                String   @id @default("default")
  eyebrow           String
  headline          String
  subheadline       String
  heroImgUrl        String
  heroImgAlt        String
  packCardImgUrl    String
  packCardCaption   String
  badgesJson        String
  primaryCtaLabel   String
  primaryCtaHref    String
  secondaryCtaLabel String
  secondaryCtaHref  String
  updatedAt         DateTime @updatedAt
}

model CookingGuide {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  equipmentLabel String
  summary        String
  tempLabel      String   @default("")
  durationLabel  String   @default("")
  coverImgUrl    String   @default("")
  videoUrl       String   @default("")
  stepsJson      String
  tipsJson       String
  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model HeroSlide {
  id                String    @id @default(cuid())
  mode              String    @default("TEXT_OVERLAY") // TEXT_OVERLAY | IMAGE_BANNER
  title             String
  imageUrl          String
  eyebrow           String    @default("")
  headline          String    @default("")
  subheadline       String    @default("")
  packCardImgUrl    String    @default("")
  packCardCaption   String    @default("")
  badgesJson        String    @default("[]")
  primaryCtaLabel   String    @default("")
  primaryCtaHref    String    @default("")
  secondaryCtaLabel String    @default("")
  secondaryCtaHref  String    @default("")
  linkHref          String    @default("")
  sortOrder         Int       @default(0)
  isActive          Boolean   @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model EventPopup {
  id        String    @id @default("default")
  isActive  Boolean   @default(false)
  title     String    @default("")
  imageUrl  String    @default("")
  linkHref  String    @default("")
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt
}
